{
  "name": "watermark-lab",
  "productName": "Watermark Lab",
  "version": "0.1.0",
  "private": true,
  "description": "Watermark Lab — centraliser, lancer et suivre les entraînements de watermarking",
  "author": "Studio AI",
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/write-workspace.cjs && concurrently -k -n vite,electron \"vite\" \"wait-on http-get://127.0.0.1:5317 && VITE_DEV_SERVER_URL=http://127.0.0.1:5317 electron .\"",
    "build": "tsc -b && vite build",
    "start": "node scripts/write-workspace.cjs && electron .",
    "selftest": "node scripts/write-workspace.cjs && WMLAB_SELFTEST=1 electron .",
    "dist": "node scripts/write-workspace.cjs && npm run build && electron-builder --mac dir --arm64",
    "icon": "../.venv/bin/python scripts/make_icon.py",
    "typecheck": "tsc -b",
    "test": "node --test \"tests/*.test.ts\"",
    "render-check": "electron scripts/render-check.cjs",
    "mock": "node scripts/mock-api.cjs",
    "remote-check": "electron scripts/remote-check.cjs"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "^5.104.0",
    "@uiw/react-codemirror": "^4.25.12",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wait-on": "^9.4.0"
  },
  "build": {
    "appId": "ai.studio.wmlab",
    "productName": "Watermark Lab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/workspace.json",
        "to": "workspace.json"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    }
  }
}
